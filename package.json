{
  "name": "billforce",
  "productName": "Billforce",
  "version": "1.1.0",
  "description": "Billforce - billing, accounts and business management for small businesses in India",
  "author": "Billforce",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "web": "npm run build && node dist/web/server.cjs",
    "e2e": "playwright test",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
